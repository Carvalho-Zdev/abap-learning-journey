CLASS zcl_angelo_002 DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.

ENDCLASS.

CLASS zcl_angelo_002 IMPLEMENTATION.

  METHOD if_oo_adt_classrun~main.

    DATA lv_nome   TYPE string.
    DATA lv_idade  TYPE i.
    DATA lv_modulo TYPE string.
    DATA lv_contador TYPE i.
    DATA lt_nomes TYPE TABLE OF string.
    DATA lv_nome_loop TYPE string.

    lv_nome = 'Angelo'.
    lv_idade = 24.
    lv_modulo = 'FI'.

    out->write( 'BEM VINDO' ).
    out->write( lv_nome ).
    out->write( lv_idade ).

    IF lv_idade >= 18.
      out->write( 'Maior de idade pode ir' ).
    ELSE.
      out->write( 'Menor de idade, nao pode ir' ).
    ENDIF.

    CASE lv_modulo.

      WHEN 'FI'.
        out->write( 'Modulo Financeiro' ).

      WHEN 'MM'.
        out->write( 'Modulo Materiais' ).

      WHEN 'SD'.
        out->write( 'Modulo Vendas' ).

      WHEN OTHERS.
        out->write( 'Modulo Desconhecido' ).

    ENDCASE.

    DO 5 TIMES.
      out->write( sy-index ).

    ENDDO.

    APPEND 'Angelo' TO lt_nomes.
    APPEND 'Aleksandra' TO lt_nomes.
    APPEND 'Maria' TO lt_nomes.
    APPEND 'Joao' TO lt_nomes.

     LOOP AT lt_nomes INTO lv_nome_loop.

     out->write( lv_nome_loop ).

     ENDLOOP.


  ENDMETHOD.

ENDCLASS.