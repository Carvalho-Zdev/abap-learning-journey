CLASS zcl_angelo_005_internal_table DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
   INTERFACES if_oo_adt_classrun.
ENDCLASS.



CLASS zcl_angelo_005_internal_table IMPLEMENTATION.


  METHOD if_oo_adt_classrun~main.

   TYPES: BEGIN OF ty_documento,
             id     TYPE i,
             status TYPE string,
             valor  TYPE p LENGTH 8 DECIMALS 2,
           END OF ty_documento.

    DATA:
      lt_documentos TYPE TABLE OF ty_documento,
      ls_documento  TYPE ty_documento,
      lv_abertos     TYPE i,
      lv_fechados   TYPE i.


    ls_documento-id = 1.
    ls_documento-status = 'ABERTO'.
    ls_documento-valor = 500.
    APPEND ls_documento TO lt_documentos.

    ls_documento-id = 2.
    ls_documento-status = 'FECHADO'.
    ls_documento-valor = 1500.
    APPEND ls_documento TO lt_documentos.

    ls_documento-id = 3.
    ls_documento-status = 'ABERTO'.
    ls_documento-valor = 3000.
    APPEND ls_documento TO lt_documentos.

    LOOP AT lt_documentos INTO ls_documento.



       CASE ls_documento-status.

      WHEN 'ABERTO'.

      lv_abertos = lv_abertos + 1.
      out->write( |Documento { ls_documento-id } está ABERTO| ).

       WHEN 'FECHADO'.

      lv_fechados = lv_fechados + 1.
      out->write( |Documento { ls_documento-id } está FECHADO| ).






      ENDCASE.

    ENDLOOP.

   out->write( |Total abertos: { lv_abertos }| ).
   out->write( |Total fechados: { lv_fechados }| ).




   ENDMETHOD.

ENDCLASS.