CLASS zcl_angelo_006_read_table DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.

  PROTECTED SECTION.
  PRIVATE SECTION.
ENDCLASS.



CLASS zcl_angelo_006_read_table IMPLEMENTATION.

 METHOD if_oo_adt_classrun~main.
TYPES: BEGIN OF ty_documento,
           id     TYPE i,
           status TYPE string,
           valor  TYPE p LENGTH 8 DECIMALS 2,
         END OF ty_documento.

  DATA:
    lt_documentos TYPE TABLE OF ty_documento,
    ls_documento  TYPE ty_documento.

  "Documento 1
  ls_documento-id = 1.
  ls_documento-status = 'ABERTO'.
  ls_documento-valor = 500.
  APPEND ls_documento TO lt_documentos.

  "Documento 2
  ls_documento-id = 2.
  ls_documento-status = 'FECHADO'.
  ls_documento-valor = 1500.
  APPEND ls_documento TO lt_documentos.

  "Documento 3
  ls_documento-id = 3.
  ls_documento-status = 'ABERTO'.
  ls_documento-valor = 3000.
  APPEND ls_documento TO lt_documentos.


   READ TABLE lt_documentos
         INTO ls_documento
         WITH KEY id = 6.
 IF sy-subrc = 0.

 out->write(
      |Documento encontrado: { ls_documento-id } |
    ).

     ELSE.

    out->write( 'Documento com ID 9 não encontrado.' ).
  ENDIF.

ENDMETHOD.


ENDCLASS.