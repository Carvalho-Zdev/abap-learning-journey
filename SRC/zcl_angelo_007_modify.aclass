CLASS zcl_angelo_007_modify DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.
  PROTECTED SECTION.
  PRIVATE SECTION.
ENDCLASS.



CLASS zcl_angelo_007_modify IMPLEMENTATION.


 METHOD if_oo_adt_classrun~main.
TYPES: BEGIN OF ty_documento,
           id     TYPE i,
           status TYPE string,
           valor  TYPE p LENGTH 8 DECIMALS 2,
         END OF ty_documento.

  DATA:
    lt_documentos TYPE TABLE OF ty_documento,
    ls_documento  TYPE ty_documento,
    lv_index      TYPE sy-tabix.





  "Documento 1
  ls_documento-id = 1.
  ls_documento-status = 'ABERTO'.
  ls_documento-valor = 500.
  APPEND ls_documento TO lt_documentos.

  "Documento 2
  ls_documento-id = 2.
  ls_documento-status = 'FECHADO'.
  ls_documento-valor = 1500.
  APPEND ls_documento TO lt_documentos.

  "Documento 3
  ls_documento-id = 3.
  ls_documento-status = 'ABERTO'.
  ls_documento-valor = 3000.
  APPEND ls_documento TO lt_documentos.


   READ TABLE lt_documentos
         INTO ls_documento
         WITH KEY id = 2.
 IF sy-subrc = 0.

    ls_documento-status = 'ABERTO'.

    MODIFY lt_documentos
     FROM ls_documento
      INDEX sy-tabix.
  ENDIF.

  LOOP AT lt_documentos INTO ls_documento.

  out->write(
    |ID: { ls_documento-id } STATUS: { ls_documento-status }|
  ).

ENDLOOP.

ENDMETHOD.

ENDCLASS.