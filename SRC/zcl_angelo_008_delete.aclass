CLASS zcl_angelo_008_delete DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
   INTERFACES if_oo_adt_classrun.

  PROTECTED SECTION.
  PRIVATE SECTION.
ENDCLASS.



CLASS zcl_angelo_008_delete IMPLEMENTATION.

 METHOD if_oo_adt_classrun~main.


    TYPES: BEGIN OF ty_documento,
           id     TYPE i,
           status TYPE string,
           valor  TYPE p LENGTH 8 DECIMALS 2,
         END OF ty_documento.

  DATA:
    lt_documentos TYPE TABLE OF ty_documento,
    ls_documento  TYPE ty_documento.






  "Documento 1
  ls_documento-id = 1.
  ls_documento-status = 'ABERTO'.
  ls_documento-valor = 500.
  APPEND ls_documento TO lt_documentos.

  "Documento 2
  ls_documento-id = 2.
  ls_documento-status = 'FECHADO'.
  ls_documento-valor = 1500.
  APPEND ls_documento TO lt_documentos.

  "Documento 3
  ls_documento-id = 3.
  ls_documento-status = 'ABERTO'.
  ls_documento-valor = 3000.
  APPEND ls_documento TO lt_documentos.

DELETE lt_documentos

  WHERE status = 'FECHADO'.


  LOOP AT lt_documentos INTO ls_documento.

    out->write(
    |ID: { ls_documento-id } STATUS: { ls_documento-status } VALOR: { ls_documento-valor }|
  ).

ENDLOOP.

ENDMETHOD.

ENDCLASS.






































