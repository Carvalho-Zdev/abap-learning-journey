CLASS zcl_angelo_022_select_cds DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.

ENDCLASS.



CLASS zcl_angelo_022_select_cds IMPLEMENTATION.

  METHOD if_oo_adt_classrun~main.

    out->write( 'Classe executou' ).

    SELECT
      FROM zi_angelo_travel_eur_cds
      FIELDS travel_id,
             customer_id,
             total_price,
             currency_code
      INTO TABLE @DATA(lt_travels)
      UP TO 40 ROWS.

    out->write( |Quantidade lida da CDS: { lines( lt_travels ) }| ).

  ENDMETHOD.

ENDCLASS.