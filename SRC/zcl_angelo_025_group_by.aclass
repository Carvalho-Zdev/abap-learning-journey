CLASS zcl_angelo_025_group_by DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.
ENDCLASS.



CLASS zcl_angelo_025_group_by IMPLEMENTATION.

 METHOD if_oo_adt_classrun~main.

SELECT
  FROM zi_angelo_travel_customer
  FIELDS city,
         COUNT( * ) AS total_trips
  GROUP BY city
  HAVING COUNT( * ) > 100
  ORDER BY total_trips DESCENDING
  INTO TABLE @DATA(lt_result).

 out->write( |Quantidade de cidades encontradas: { lines( lt_result ) }| ).
LOOP AT lt_result INTO DATA(ls_result).

  out->write(
    |Cidade: { ls_result-city } - Total de viagens: { ls_result-total_trips }|
  ).

ENDLOOP.

ENDMETHOD.
ENDCLASS.