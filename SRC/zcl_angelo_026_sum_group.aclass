CLASS zcl_angelo_026_sum_group DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.

ENDCLASS.


CLASS zcl_angelo_026_sum_group IMPLEMENTATION.

  METHOD if_oo_adt_classrun~main.

    SELECT
      FROM zi_angelo_travel_customer
      FIELDS country_code,
             currency_code,
             SUM( total_price ) AS total_value
      GROUP BY country_code,
               currency_code
      ORDER BY total_value DESCENDING
      INTO TABLE @DATA(lt_result).

    out->write(
      |Quantidade de grupos encontrados: { lines( lt_result ) }|
    ).

 LOOP AT lt_result INTO DATA(ls_result).

  out->write(
    |{ sy-tabix }. País: { ls_result-country_code } - Valor total: { ls_result-total_value } { ls_result-currency_code }|
  ).

ENDLOOP.

  ENDMETHOD.

ENDCLASS.