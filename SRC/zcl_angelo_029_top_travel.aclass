CLASS zcl_angelo_029_top_travel DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.
ENDCLASS.



CLASS zcl_angelo_029_top_travel IMPLEMENTATION.


METHOD if_oo_adt_classrun~main.

    out->write( 'TOP 5 VIAGENS EM EUR OU ACIMA DE 40000' ).
    out->write( '--------------------------------------' ).

  SELECT
  FROM zi_angelo_travel_customer
  FIELDS travel_id,
         customer_id,
         total_price,
         currency_code
  WHERE currency_code = 'EUR'
  OR  total_price > 40000
  ORDER BY total_price DESCENDING
  INTO TABLE @DATA(lt_most_expensive)
  UP TO 5 ROWS.



LOOP AT lt_most_expensive INTO DATA(ls_most_expensive).

  out->write(
    |{ sy-tabix } - Travel: { ls_most_expensive-travel_id } - |
    && |Cliente: { ls_most_expensive-customer_id } - |
    && |Valor: { ls_most_expensive-total_price DECIMALS = 2 } |
    && |{ ls_most_expensive-currency_code }|
  ).

ENDLOOP.





ENDMETHOD.


ENDCLASS.