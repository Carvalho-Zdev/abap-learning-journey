CLASS zcl_angelo_030_top_customers DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
       INTERFACES if_oo_adt_classrun.
ENDCLASS.



CLASS zcl_angelo_030_top_customers IMPLEMENTATION.

METHOD if_oo_adt_classrun~main.

out->write( 'TOP 10 CLIENTES' ).
out->write( '--------------------------------------' ).

 SELECT
    FROM zi_angelo_travel_customer
    FIELDS
     customer_id,
     COUNT( * ) AS total_trips
     GROUP BY customer_id
     ORDER BY total_trips DESCENDING,
     customer_id ASCENDING
     INTO TABLE @DATA(lt_top_costomers)
     UP TO 10 ROWS.

     LOOP AT lt_top_costomers INTO DATA(ls_top_customer).

  out->write(
    |{ sy-tabix } - Cliente: { ls_top_customer-customer_id } - |
    && |Viagens: { ls_top_customer-total_trips }|
  ).

ENDLOOP.






ENDMETHOD.

ENDCLASS.