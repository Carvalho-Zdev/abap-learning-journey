CLASS zcl_angelo_032_in_operator DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.
ENDCLASS.



CLASS zcl_angelo_032_in_operator IMPLEMENTATION.

METHOD if_oo_adt_classrun~main.

out->write( 'Quais são as 10 viagens mais caras em EUR ou USD?' ).
out->write( '--------------------------------------' ).


SELECT
   FROM zi_angelo_travel_customer
    FIELDS travel_id,
           customer_id,
          total_price,
          currency_code
    WHERE currency_code IN ('EUR','USD')
    ORDER BY total_price  DESCENDING

     INTO TABLE @DATA(lt_top_travels)
      UP TO 200 ROWS.


LOOP AT lt_top_travels INTO DATA(ls_top_travels).

out->write(
  |{ sy-tabix } - Travel: { ls_top_travels-travel_id } - |
  && |Cliente: { ls_top_travels-customer_id } - |
  && |Valor: { ls_top_travels-total_price } |
  && |{ ls_top_travels-currency_code }|
).


ENDLOOP.


ENDMETHOD.
ENDCLASS.




























