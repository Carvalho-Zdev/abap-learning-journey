CLASS zcl_angelo_033_between DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
   INTERFACES if_oo_adt_classrun.
ENDCLASS.



CLASS zcl_angelo_033_between IMPLEMENTATION.

METHOD if_oo_adt_classrun~main.

out->write( 'TOP 10 VIAGENS EM EUR ENTRE 10000 E 20000' ).
out->write( '--------------------------------------' ).

SELECT
   FROM zi_angelo_travel_customer
    FIELDS travel_id,
           customer_id,
          total_price,
          currency_code
    WHERE currency_code = 'EUR'
     AND total_price BETWEEN 10000 AND 20000
    ORDER BY total_price  DESCENDING

     INTO TABLE @DATA(lt_top_travels)
     UP TO 10 ROWS.

  LOOP AT lt_top_travels INTO DATA(ls_top_travels).

out->write(
  |{ sy-tabix } - Travel: { ls_top_travels-travel_id } - |
  && |Cliente: { ls_top_travels-customer_id } - |
  && |Valor: { ls_top_travels-total_price } |
  && |{ ls_top_travels-currency_code }|
).


ENDLOOP.

ENDMETHOD.

ENDCLASS.