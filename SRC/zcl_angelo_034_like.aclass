CLASS zcl_angelo_034_like DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
  INTERFACES if_oo_adt_classrun.
ENDCLASS.



CLASS zcl_angelo_034_like IMPLEMENTATION.
METHOD if_oo_adt_classrun~main.

out->write( 'Quais pessoas moram em cidades que começam com San?' ).
out->write( '--------------------------------------' ).

SELECT
  FROM zi_angelo_travel_customer
  FIELDS DISTINCT
         customer_id,
         first_name,
         last_name,
         city
  WHERE city LIKE 'San%'
  ORDER BY city ASCENDING,
           last_name ASCENDING
  INTO TABLE @DATA(lt_top_citys)
  UP TO 10 ROWS.

LOOP AT lt_top_citys INTO DATA(ls_top_citys).

  out->write(
    |{ sy-tabix } - Cliente: { ls_top_citys-customer_id } - |
    && |{ ls_top_citys-first_name } { ls_top_citys-last_name } - |
    && |Cidade: { ls_top_citys-city }|
  ).

ENDLOOP.





ENDMETHOD.
ENDCLASS.