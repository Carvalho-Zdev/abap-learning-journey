CLASS zcl_angelo_037_null DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.

ENDCLASS.



CLASS zcl_angelo_037_null IMPLEMENTATION.

METHOD if_oo_adt_classrun~main.

out->write( 'VIAGENS COM DESCRICAO PREENCHIDA' ).
out->write( '--------------------------------------' ).

SELECT
      FROM zi_angelo_travel_customer
      FIELDS travel_id,
             customer_id,
             description
      WHERE description IS  NULL
       OR description = ''
      ORDER BY travel_id ASCENDING
      INTO TABLE @DATA(lt_top_travels)
      UP TO 10 ROWS.

    LOOP AT lt_top_travels INTO DATA(ls_top_travels).

      out->write(
        |{ sy-tabix } - Travel: { ls_top_travels-travel_id } - |
        && |Cliente: { ls_top_travels-customer_id } - |
        && |Descricao: { ls_top_travels-description }|
      ).

    ENDLOOP.
out->write( 'VIAGENS SEM DESCRICAO' ).



ENDMETHOD.
ENDCLASS.