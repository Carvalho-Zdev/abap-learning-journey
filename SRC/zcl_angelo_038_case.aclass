CLASS zcl_angelo_038_case DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
  INTERFACES if_oo_adt_classrun.

ENDCLASS.



CLASS zcl_angelo_038_case IMPLEMENTATION.
METHOD if_oo_adt_classrun~main.

out->write( '--------------------------------------' ).

SELECT
   FROM zi_angelo_travel_customer
    FIELDS travel_id,
           customer_id,
          total_price,
          currency_code,
           CASE
           WHEN total_price >= 30000 THEN 'ALTO'
           WHEN total_price >= 15000 THEN 'MEDIO'
           ELSE 'BAIXO'
         END AS categoria
  WHERE currency_code = 'EUR'
  ORDER BY total_price DESCENDING
  INTO TABLE @DATA(lt_travels)
  UP TO 10 ROWS.


LOOP AT lt_travels INTO DATA(ls_travel).

  out->write(
    |{ sy-tabix } - Travel: { ls_travel-travel_id } - |
    && |Cliente: { ls_travel-customer_id } - |
    && |Valor: { ls_travel-total_price } { ls_travel-currency_code } - |
    && |Categoria: { ls_travel-categoria }|
  ).

ENDLOOP.













ENDMETHOD.
ENDCLASS.