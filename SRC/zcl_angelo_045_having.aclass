CLASS zcl_angelo_045_having DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.

ENDCLASS.


CLASS zcl_angelo_045_having IMPLEMENTATION.

  METHOD if_oo_adt_classrun~main.




  SELECT FROM /dmo/travel
    FIELDS
      agency_id,
      currency_code,
      COUNT( * )         AS total_travels,
      SUM( total_price ) AS total_sales
    GROUP BY
      agency_id,
      currency_code
    HAVING
      COUNT( * ) > 30
    ORDER BY
      total_travels DESCENDING
    INTO TABLE @DATA(lt_result).

  out->write(
  |Total de linhas: { lines( lt_result ) }|
).



LOOP AT lt_result INTO DATA(ls_result).

  out->write(
    |Agência: { ls_result-agency_id } - | &&
    |Moeda: { ls_result-currency_code } - | &&
    |Viagens: { ls_result-total_travels } - | &&
    |Valor: { ls_result-total_sales }|
  ).

ENDLOOP.











  ENDMETHOD.

ENDCLASS.