CLASS zcl_angelo_046_where_having DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.

  PROTECTED SECTION.
  PRIVATE SECTION.

ENDCLASS.


CLASS zcl_angelo_046_where_having IMPLEMENTATION.

  METHOD if_oo_adt_classrun~main.




  SELECT FROM /dmo/travel
    FIELDS
      agency_id,
      COUNT( * )         AS total_travels,
      SUM( total_price ) AS total_sales
    WHERE
      currency_code = 'EUR'
    GROUP BY
      agency_id
    HAVING
      COUNT( * ) > 30
    ORDER BY
      total_travels DESCENDING
    INTO TABLE @DATA(lt_result).

  out->write(
    |Total de agências encontradas: { lines( lt_result ) }|
  ).

  LOOP AT lt_result INTO DATA(ls_result).

    out->write(
      |Agência: { ls_result-agency_id } - | &&
      |Viagens em EUR: { ls_result-total_travels } - | &&
      |Valor total: { ls_result-total_sales }|
    ).

  ENDLOOP.










  ENDMETHOD.

ENDCLASS.