CLASS zcl_angelo_047_aggregates DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .


  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.

  PROTECTED SECTION.
  PRIVATE SECTION.

ENDCLASS.

CLASS zcl_angelo_047_aggregates IMPLEMENTATION.


METHOD if_oo_adt_classrun~main.

  SELECT FROM /dmo/travel
    FIELDS
      agency_id,
      AVG( total_price ) AS average_price,
      MIN( total_price ) AS minimum_price,
      MAX( total_price ) AS maximum_price
    WHERE
      currency_code = 'EUR'
    GROUP BY
      agency_id
    ORDER BY
      agency_id
    INTO TABLE @DATA(lt_result).

  out->write(
    |Total de agências: { lines( lt_result ) }|
  ).

  LOOP AT lt_result INTO DATA(ls_result).

    out->write(
      |Agência: { ls_result-agency_id } - | &&
      |Média: { ls_result-average_price } - | &&
      |Mínimo: { ls_result-minimum_price } - | &&
      |Máximo: { ls_result-maximum_price }|
    ).

  ENDLOOP.

ENDMETHOD.

ENDCLASS.