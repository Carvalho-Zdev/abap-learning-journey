CLASS zcl_angelo_050_travel DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.

    INTERFACES if_oo_adt_classrun.

    METHODS constructor
      IMPORTING
        iv_travel_id   TYPE /dmo/travel_id OPTIONAL
        iv_customer_id TYPE /dmo/customer_id OPTIONAL
        iv_agency_id   TYPE /dmo/agency_id OPTIONAL.

    METHODS get_summary
      RETURNING
        VALUE(rv_summary) TYPE string.

    METHODS get_customer
      RETURNING
        VALUE(rv_customer_id) TYPE /dmo/customer_id.

    METHODS change_customer
      IMPORTING
        iv_customer_id TYPE /dmo/customer_id.

    METHODS change_agency
      IMPORTING
        iv_agency_id TYPE /dmo/agency_id.

    PRIVATE SECTION.

    DATA mv_travel_id   TYPE /dmo/travel_id.
    DATA mv_customer_id TYPE /dmo/customer_id.
    DATA mv_agency_id   TYPE /dmo/agency_id.

ENDCLASS.


CLASS zcl_angelo_050_travel IMPLEMENTATION.

  METHOD constructor.

    mv_travel_id   = iv_travel_id.
    mv_customer_id = iv_customer_id.
    mv_agency_id   = iv_agency_id.

  ENDMETHOD.


  METHOD change_agency.

    mv_agency_id = iv_agency_id.

  ENDMETHOD.


  METHOD get_summary.

    rv_summary =
      |Travel ID: { mv_travel_id }{ cl_abap_char_utilities=>newline }| &&
      |Customer ID: { mv_customer_id }{ cl_abap_char_utilities=>newline }| &&
      |Agency ID: { mv_agency_id }|.

  ENDMETHOD.


  METHOD get_customer.

    rv_customer_id = mv_customer_id.

  ENDMETHOD.


  METHOD change_customer.

    mv_customer_id = iv_customer_id.

  ENDMETHOD.


  METHOD if_oo_adt_classrun~main.

    DATA(lo_travel) = NEW zcl_angelo_050_travel(
      iv_travel_id   = '00000001'
      iv_customer_id = '000001'
      iv_agency_id   = '070001'
    ).

    out->write(
      |Before change:{ cl_abap_char_utilities=>newline }{
        lo_travel->get_summary( )
      }|
    ).

    lo_travel->change_customer(
      iv_customer_id = '000999'
    ).

    lo_travel->change_agency(
  iv_agency_id = '070999'
    ).

    DATA(lv_customer_id) = lo_travel->get_customer( ).

    out->write(
      |Customer returned by get_customer: { lv_customer_id }|
    ).

    out->write(
      |After change:{ cl_abap_char_utilities=>newline }{
        lo_travel->get_summary( )
      }|
    ).



  ENDMETHOD.

  ENDCLASS.





