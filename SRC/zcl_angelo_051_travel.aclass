CLASS zcl_angelo_051_travel DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.

    INTERFACES if_oo_adt_classrun.

    METHODS constructor
      IMPORTING
        iv_travel_id TYPE /dmo/travel_id OPTIONAL.



    METHODS get_travel_id
      RETURNING
        VALUE(rv_travel_id) TYPE /dmo/travel_id.


    METHODS set_travel_id
      IMPORTING
        iv_travel_id TYPE /dmo/travel_id.


  PRIVATE SECTION.

    DATA mv_travel_id TYPE /dmo/travel_id.



ENDCLASS.



CLASS zcl_angelo_051_travel IMPLEMENTATION.

  METHOD constructor.

    mv_travel_id = iv_travel_id.

  ENDMETHOD.


  METHOD get_travel_id.

    rv_travel_id = mv_travel_id.

  ENDMETHOD.



  METHOD set_travel_id.

    mv_travel_id = iv_travel_id.


  ENDMETHOD.

  METHOD if_oo_adt_classrun~main.

    DATA(lo_travel) = NEW zcl_angelo_051_travel(
      iv_travel_id = '00000001'
    ).


    out->write( |Before:{ lo_travel->get_travel_id( ) }|
     ).



    lo_travel->set_travel_id( iv_travel_id = '00000099'
    ).

    out->write(
  |After: { lo_travel->get_travel_id( ) }|
).





  ENDMETHOD.


ENDCLASS.


