CLASS zcl_angelo_054_validation DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.

    INTERFACES if_oo_adt_classrun.

    METHODS constructor
      IMPORTING
        iv_travel_id TYPE /dmo/travel_id OPTIONAL.

    METHODS get_travel_id
      RETURNING
        VALUE(rv_travel_id) TYPE /dmo/travel_id.

    METHODS set_travel_id
      IMPORTING
        iv_travel_id TYPE /dmo/travel_id.

  PRIVATE SECTION.

    DATA mv_travel_id TYPE /dmo/travel_id.

    ENDCLASS.


 CLASS zcl_angelo_054_validation IMPLEMENTATION.

  METHOD constructor.

    me->mv_travel_id = iv_travel_id.

  ENDMETHOD.


  METHOD get_travel_id.

    rv_travel_id = me->mv_travel_id.

  ENDMETHOD.


  METHOD set_travel_id.

    IF iv_travel_id IS INITIAL.
      RETURN.
    ENDIF.

    me->mv_travel_id = iv_travel_id.

  ENDMETHOD.


 METHOD if_oo_adt_classrun~main.

  DATA(lo_travel) = NEW zcl_angelo_054_validation(
    iv_travel_id = '00000001'
  ).

  out->write(
    |Before invalid change: { lo_travel->get_travel_id( ) }|
  ).

  lo_travel->set_travel_id(
    iv_travel_id = '00000000'
  ).

  out->write(
    |After invalid change: { lo_travel->get_travel_id( ) }|
  ).

ENDMETHOD.

ENDCLASS.
