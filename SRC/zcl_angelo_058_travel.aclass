CLASS zcl_angelo_058_travel DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.

    INTERFACES if_oo_adt_classrun.

    METHODS load
    IMPORTING
    iv_travel_id TYPE /dmo/travel_id.



    METHODS get_summary
     RETURNING
      VALUE(rv_summary) TYPE string.





  PRIVATE SECTION.

       DATA mv_travel_id   TYPE /dmo/travel_id.
       DATA mv_customer_id TYPE /dmo/customer_id.
       DATA mv_agency_id   TYPE /dmo/agency_id.


ENDCLASS.


CLASS zcl_angelo_058_travel IMPLEMENTATION.

 METHOD load.

   SELECT SINGLE FROM /dmo/travel
    FIELDS
      travel_id,
      customer_id,
      agency_id
    WHERE travel_id = @iv_travel_id
    INTO @DATA(ls_travel).

  IF sy-subrc <> 0.
    RETURN.
  ENDIF.

  me->mv_travel_id   = ls_travel-travel_id.
  me->mv_customer_id = ls_travel-customer_id.
  me->mv_agency_id   = ls_travel-agency_id.

  ENDMETHOD.

  METHOD get_summary.

     rv_summary =
    |Travel ID: { me->mv_travel_id }{ cl_abap_char_utilities=>newline }| &&
    |Customer ID: { me->mv_customer_id }{ cl_abap_char_utilities=>newline }| &&
    |Agency ID: { me->mv_agency_id }|.

   ENDMETHOD.




  METHOD if_oo_adt_classrun~main.

         DATA(lo_travel) = NEW zcl_angelo_058_travel( ).

       lo_travel->load(
       iv_travel_id = '00034'
      ).

      out->write(
      lo_travel->get_summary( )
      ).


  ENDMETHOD.

ENDCLASS.